# RuleGo-Server with a Python runtime, so stock `exec` nodes can run this repo's step
# scripts. Build from the repo root:
#   podman build -f rulego/Containerfile -t localhost/kernel-rulego .
# Findings and options: docs/RULEGO_NOTES.md.
ARG GO_IMAGE=docker.io/library/golang:1.25
ARG PY_IMAGE=docker.io/library/python:3.12-slim

FROM ${GO_IMAGE} AS build
# Pinned: the server ships inside the rulego repo (server/) since the standalone
# rulego-server repo stopped in April 2026. v0.38.0 = commit 13787639c406.
ARG RULEGO_VERSION=v0.38.0
RUN git clone --depth 1 --branch ${RULEGO_VERSION} https://github.com/rulego/rulego.git /src
WORKDIR /src/server/cmd/server
# Standard components only (exec, flow, while, switch, ...): no extension tags.
RUN CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /out/rulego-server .

FROM ${PY_IMAGE}
RUN useradd --create-home --uid 10001 rulego
COPY pyproject.toml /opt/kernel/pyproject.toml
RUN pip install --no-cache-dir "psycopg[binary]>=3.2" "pyyaml>=6" "jsonschema>=4.20" "anthropic>=0.40"
COPY --from=build /out/rulego-server /usr/local/bin/rulego-server
COPY rulego/config.conf /etc/rulego/config.conf
# The repo is mounted read-only at /repo; its packages import from there.
ENV PYTHONPATH=/repo PYTHONUNBUFFERED=1
RUN mkdir -p /var/lib/rulego && chown rulego:rulego /var/lib/rulego
USER rulego
WORKDIR /var/lib/rulego
EXPOSE 9090
CMD ["rulego-server", "-c=/etc/rulego/config.conf"]
