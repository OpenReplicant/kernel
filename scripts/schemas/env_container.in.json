{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "env_container input: a command to run in the sandbox",
  "type": "object", "additionalProperties": false,
  "required": ["work_dir"],
  "properties": {
    "work_dir": { "type": "string", "description": "Host directory mounted read-only at /work; the only path the container sees" },
    "files": { "type": "object", "additionalProperties": { "type": "string" },
               "description": "Files to write into work_dir first, by relative path" },
    "command": { "type": "array", "items": { "type": "string" }, "minItems": 1, "default": ["python", "main.py"] },
    "image": { "type": "string", "default": "localhost/kernel-sandbox:latest" },
    "timeout_s": { "type": "number", "exclusiveMinimum": 0, "default": 10 },
    "cpus": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
    "memory": { "type": "string", "pattern": "^[0-9]+[kmg]$", "default": "256m" },
    "pids": { "type": "integer", "minimum": 1, "default": 64 },
    "max_output": { "type": "integer", "minimum": 0, "default": 1048576,
                    "description": "Bytes of stdout and of stderr kept; the rest is counted, not returned" }
  }
}
