# Image that untrusted payloads (model-written solutions, benchmark tests) run in.
# Runtime limits (no network, read-only root, CPU/memory/pids, timeout) are applied by
# pclib/sandbox.py at `podman run` time, not here (docs/V1_BUILD_PLAN.md M6).
#   podman build -t localhost/kernel-sandbox sandbox
ARG BASE=docker.io/library/python:3.12-slim
FROM ${BASE}

RUN useradd --create-home --uid 10001 runner \
 && mkdir /work && chown runner:runner /work

USER runner
WORKDIR /work
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
