# The explorer: static pages, and /api forwarded to PostgREST, which runs as the reader role,
# or as the approver for a request with a verified sign-in token (ADR 0030).
{
	admin off
	auto_https off
	# No request logs: URLs carry search terms and ids (invariant 9). Caddy logs only its own
	# start-up and configuration messages.
	log default {
		exclude http.log.error
	}
}

:8080 {
	encode gzip

	# Only reads and decisions reach the API: GET for tables and views, POST only for /rpc/
	# functions. PostgREST rolls back every transaction unless a decision asks to commit; the
	# reader role cannot write, and the approver can only call kernel.decide.
	@reads {
		path /api/*
		method GET HEAD
	}
	@rpc {
		path /api/rpc/*
		method POST
	}
	handle @reads {
		uri strip_prefix /api
		reverse_proxy api:3000
	}
	handle @rpc {
		uri strip_prefix /api
		reverse_proxy api:3000
	}
	handle /api/* {
		respond "The explorer's API only reads, and decides through /rpc/decide." 405
	}

	handle {
		root * /srv
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Alpine.js evaluates its directives with Function(), hence unsafe-eval for scripts. The one
		# style hash is the rule Cytoscape.js injects for its container (position: relative).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'sha256-pgvDUBa4IjFA2yuSJ2cqcyxmNYJMborsd0ORcRv9vw8='; img-src 'self' data:; frame-ancestors 'none'"
	}
}
