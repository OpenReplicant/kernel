# Front door. Local only (compose publishes 127.0.0.1:8080). Replaceable by any reverse proxy:
# the kernel depends on nothing here.
:80 {
	encode zstd gzip

	# Kernel MCP server (streamable HTTP). Callers send their own bearer token.
	handle /mcp* {
		reverse_proxy kernel-mcp:8000
	}

	# Optional REST API (profile http-api).
	handle_path /api/* {
		reverse_proxy postgrest:3000
	}
}
