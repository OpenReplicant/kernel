# Front door. Local only (compose publishes 127.0.0.1:8080). Replaceable by any reverse proxy:
# the kernel depends on nothing here.
:80 {
	encode zstd gzip

	# Kernel MCP server (streamable HTTP) and the UI (an MCP client). Callers send their own bearer
	# token (kk token ROLE).
	handle /mcp* {
		reverse_proxy kernel:8000
	}
	handle {
		reverse_proxy kernel:8000
	}
}
