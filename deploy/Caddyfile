# Front door. Local by default (compose publishes 127.0.0.1:8080). With KK_SITE set to a public host
# name (deploy/public.yaml), Caddy gets and renews its certificate and serves HTTPS there. Replaceable by
# any reverse proxy: the kernel depends on nothing here.
{$KK_SITE::80} {
	encode zstd gzip

	# Kernel MCP server (streamable HTTP) and the UI (an MCP client). Callers send their own bearer
	# token (kk token ROLE).
	handle /mcp* {
		reverse_proxy kernel:8000
	}
	handle {
		reverse_proxy kernel:8000
	}
}
