# Copy to deploy/.env (never commit it) and fill in.

POSTGRES_PASSWORD=
KK_AUTHENTICATOR_PASSWORD=
# HS256 secret shared by PostgREST and the token minting script (>= 32 chars)
KK_JWT_SECRET=

# Pin every image by exact tag or digest. Look up the current releases; don't guess.
POSTGREST_IMAGE=postgrest/postgrest:<pin-current-tag>
CADDY_IMAGE=caddy:2-alpine
RULEGO_SERVER_IMAGE=<pin-rulego-server-image-or-build-from-source>
PG_EVENTSERV_IMAGE=<pin-pg_eventserv-image>

# Module JWTs (one database role per module), minted by: python scripts/mint_jwt.py <db_role>
KK_JWT_VALIDATOR=
KK_JWT_BELIEF=
KK_JWT_RUNNER_PY=
KK_JWT_SELF_ENCODER=
KK_JWT_GRAPH_DECODER=
KK_JWT_DECODER_RULEGO=
