# Copy to deploy/.env (never commit it) and fill in.

POSTGRES_PASSWORD=
# The services' login (switches to each part's own role). Never give it to an agent.
KK_AUTHENTICATOR_PASSWORD=
# HS256 secret for MCP over HTTP: kk serve verifies tokens, `kk token ROLE` mints them (>= 32 chars).
KK_JWT_SECRET=

# Pin every image by exact tag or digest. Look up the current releases; don't guess.
CADDY_IMAGE=caddy:2.11.7-alpine

# A public host name for HTTPS (deploy/public.yaml); leave empty for local use.
KK_SITE=

# People and agents get their own logins (the password is printed once):
#   docker compose ... run --rm init kk person add owner --steward
#   docker compose ... run --rm init kk agent add claude-code
# A person signs in to the UI (http://127.0.0.1:8080/ui/) with their name and that password, or
# reviews from the host (publish the db port):
#   KK_DATABASE_URL=postgresql://person_owner:<password>@localhost:5432/kk kk review list
