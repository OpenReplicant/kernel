# Copy to deploy/.env (never commit it) and fill in.

POSTGRES_PASSWORD=
KK_AUTHENTICATOR_PASSWORD=
# Own logins for a harness agent and the local owner (stdio MCP, scripts/review.py). Leave empty to
# keep a role nologin. Never give an agent the authenticator password: it can switch to any role.
KK_AGENT_CLAUDE_CODE_PASSWORD=
KK_OWNER_PASSWORD=
# HS256 secret shared by kernel-mcp (http mode), PostgREST and the token minting script (>= 32 chars)
KK_JWT_SECRET=

# Pin every image by exact tag or digest. Look up the current releases; don't guess.
POSTGREST_IMAGE=postgrest/postgrest:v16.4
CADDY_IMAGE=caddy:2.11.7-alpine

# Module JWTs, only for modules that call the optional REST API (profile http-api):
KK_JWT_SELF_ENCODER=
KK_JWT_INGEST_FILTER=

# People. A person reviews and approves module and vocabulary changes (review lane):
#   DATABASE_URL=postgresql://person_owner:$KK_OWNER_PASSWORD@localhost:5432/kk python scripts/review.py list
# (publish the db port, or run it inside the db container, to reach it from the host)
