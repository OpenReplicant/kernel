{
  "mcpServers": {
    "kernel": {
      "command": "python",
      "args": [
        "-m",
        "kernel_mcp"
      ],
      "env": {
        "PYTHONPATH": "${KK_REPO_PATH}/modules/kernel-mcp",
        "DATABASE_URL": "${KK_DATABASE_URL}",
        "KK_ROLE": "agent_claude_code"
      }
    },
    "git": {
      "command": "uvx",
      "args": [
        "--from",
        "mcp-server-git>=2026.1.14",
        "mcp-server-git",
        "--repository",
        "${KK_REPO_PATH}"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${KK_WORKSPACE}"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server",
        "stdio",
        "--read-only",
        "--toolsets",
        "repos,actions"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
