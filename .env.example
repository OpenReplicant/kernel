# Copy to .env to override the defaults used by docker compose and the Makefile.
WMK_DB_PASSWORD=postgres
WMK_WRITER_PASSWORD=writer
WMK_READER_PASSWORD=reader
WMK_DB_PORT=5432
WMK_GATEWAY_PORT=8000
# interactive or eval
WMK_PROFILE=interactive
# Optional OpenAI-compatible embeddings endpoint, e.g. https://api.example.com/v1/embeddings
WMK_EMBEDDING_URL=
WMK_EMBEDDING_MODEL=
WMK_EMBEDDING_API_KEY=
