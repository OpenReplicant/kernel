# BBO (BPMN 2.0 Based Ontology), subset: the subset of terms this platform uses (generated by scripts/vocab_subset.py;
# regenerate, don't edit). Upstream https://www.irit.fr/recherches/MELODI/ontologies/BBO version 1.0.0, sha256 921331ea912ac4ca008513eaac785b5d3c42beb153c61f6b28b667b75e0eeea7.
# License https://creativecommons.org/licenses/by/4.0/. Terms: Process Task UserTask ServiceTask ManualTask ExclusiveGateway ParallelGateway InclusiveGateway StartEvent EndEvent Role has_flowElements has_container has_nextFlowNode has_previousFlowNode has_resource

@prefix bbo: <https://www.irit.fr/recherches/MELODI/ontologies/BBO#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

bbo:EndEvent a owl:Class ;
    rdfs:label "EndEvent"@en ;
    rdfs:comment "As the name implies, the End Event indicates where a Process will end. In terms of Sequence Flows, the End Event ends the flow of the Process, and thus, will not have any outgoing Sequence Flows—no Sequence Flow can connect from an End Event."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:ThrowEvent .

bbo:ExclusiveGateway a owl:Class ;
    rdfs:label "ExclusiveGateway"@en ;
    rdfs:comment "A diverging Exclusive Gateway (Decision) is used to create alternative paths within a Process flow. This is basically the “diversion point in the road” for a Process. For a given instance of the Process, only one of the paths can be taken."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Gateway .

bbo:InclusiveGateway a owl:Class ;
    rdfs:label "InclusiveGateway"@en ;
    rdfs:comment "A diverging Inclusive Gateway (Inclusive Decision) can be used to create alternative but also parallel paths within a Process flow. Unlike the Exclusive Gateway, all condition Expressions are evaluated. The true evaluation of one condition Expression does not exclude the evaluation of other condition Expressions. All Sequence Flows with a true evaluation will be traversed by a token. Since each path is considered to be independent, all combinations of the paths MAY be taken, from zero to all. However, it should be designed so that at least one path is taken."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Gateway .

bbo:ManualTask a owl:Class ;
    rdfs:label "ManualTask"@en ;
    rdfs:comment "A Manual Task is a Task that is expected to be performed without the aid of any business process execution engine or any application. An example of this could be a telephone technician installing a telephone at a customer location."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Task .

bbo:ParallelGateway a owl:Class ;
    rdfs:label "ParallelGateway"@en ;
    rdfs:comment "A Parallel Gateway is used to synchronize (combine) parallel flows and to create parallel flows."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Gateway .

bbo:Process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:comment "A sequence or flow of Activities in an organization with the objective of carrying out work. In BPMN, a Process is depicted as a graph of Flow Elements, which are a set of Activities, Events, Gateways, and Sequence Flow that adhere to a finite execution semantics."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:CallableElement,
        bbo:FlowElementsContainer .

bbo:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> .

bbo:ServiceTask a owl:Class ;
    rdfs:label "ServiceTask"@en ;
    rdfs:comment "A Service Task is a Task that uses some sort of service, which could be a Web service or an automated application."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Task .

bbo:StartEvent a owl:Class ;
    rdfs:label "StartEvent"@en ;
    rdfs:comment "As the name implies, the Start Event indicates where a particular Process will start. In terms of Sequence Flows, the Start Event starts the flow of the Process, and thus, will not have any incoming Sequence Flows—no Sequence Flow can connect to a Start Event. flow of the Process and does not have any incoming Sequence Flow, but can have a Trigger. The Start Event is displayed as a circle, drawn with a single thin line."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:CatchEvent .

bbo:UserTask a owl:Class ;
    rdfs:label "UserTask"@en ;
    rdfs:comment "A User Task is a typical “workflow” Task where a human performer performs the Task with the assistance of a software application and is scheduled through a task list manager of some sort."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Task .

bbo:has_container a owl:ObjectProperty ;
    rdfs:label "has_container"@en ;
    rdfs:comment "[IRIT] this relation references the FlowElementContainer that includes the FlowElement"@en ;
    rdfs:domain bbo:FlowElement ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:range bbo:FlowElementsContainer ;
    owl:inverseOf bbo:has_flowElements .

bbo:has_nextFlowNode a owl:ObjectProperty ;
    rdfs:domain bbo:FlowNode ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:range bbo:FlowNode ;
    owl:inverseOf bbo:has_previousFlowNode .

bbo:has_resource a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:range bbo:Resource .

bbo:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "Work that a company or organization performs using business processes. An activity can be atomic or non-atomic (compound). The types of activities that are a part of a Process Model are: Process, Sub-Process, and Task."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:FlowNode .

bbo:CallableElement a owl:Class ;
    rdfs:label "CallableElement"@en ;
    rdfs:comment "CallableElement is the abstract super class of all Activities that have been defined outside of a Process or Choreography but which can be called (or reused), by a Call Activity, from within a Process or Choreography. It MAY reference Interfaces that define the service operations that it provides. The BPMN elements that can be called by Call Activities (i.e., are CallableElements) are: Process and GlobalTask (see Figure 10.43)."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:RootElement .

bbo:CatchEvent a owl:Class ;
    rdfs:label "CatchEvent"@en ;
    rdfs:comment "Events that catch a trigger. All Start Events and some Intermediate Events are catching Events."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Event .

bbo:RootElement a owl:Class ;
    rdfs:label "RootElement"@en ;
    rdfs:comment "RootElement is the abstract super class for all BPMN elements that are contained within Definitions. When contained within Definitions, these elements have their own defined life-cycle and are not deleted with the deletion of other elements. Examples of concrete RootElements include Collaboration, Process, and Choreography. Depending on their use, RootElements can be referenced by multiple other elements (i.e., they can be reused). Some RootElements MAY be contained within other elements instead of Definitions. This is done to avoid the maintenance overhead of an independent life-cycle. For example, an EventDefinition would be contained in a Process since it is used only there. In this case the EventDefinition would be dependent on the tool life-cycle of the Process."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> .

bbo:ThrowEvent a owl:Class ;
    rdfs:label "ThrowEvent"@en ;
    rdfs:comment "Events that throw a Result. All End Events and some Intermediate Events are throwing Events that MAY eventually be caught by another Event. Typically the trigger carries information out of the scope where the throw Event occurred into the scope of the catching Events. The throwing of a trigger MAY be either implicit as defined by this standard or an extension to it or explicit by a throw Event"@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Event .

bbo:has_flowElements a owl:ObjectProperty ;
    rdfs:label "has_flowElements"@en ;
    rdfs:comment "This association specifies the particular flow elements contained in a FlowElementContainer. Flow elements are Events, Gateways, Sequence Flows, Activities, Data Objects, Data Associations, and Choreography Activities."@en ;
    rdfs:domain bbo:FlowElementsContainer ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:range bbo:FlowElement .

bbo:has_previousFlowNode a owl:ObjectProperty ;
    rdfs:domain bbo:FlowNode ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:range bbo:FlowNode .

bbo:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "An Event is something that “happens” during the course of a Process. These Events affect the flow of the Process and usually have a cause or an impact and in general require or allow for a reaction. The term “event” is general enough to cover many things in a Process. The start of an Activity, the end of an Activity, the change of state of a document, a Message that arrives, etc., all could be considered Events."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:FlowNode .

bbo:FlowElement a owl:Class ;
    rdfs:label "FlowElement"@en ;
    rdfs:comment "FlowElement is the abstract super class for all elements that can appear in a Process flow, which are FlowNodes (see page 99, which consist of Activities (see page 151), Choreography Activities (see page 321) Gateways (see page 287), and Events (see page 233), Data Objects (see page 205), Data Associations (see page 221), and Sequence Flows (see page 97)."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> .

bbo:FlowElementsContainer a owl:Class ;
    rdfs:label "FlowElementsContainer"@en ;
    rdfs:comment "/"@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> .

bbo:Gateway a owl:Class ;
    rdfs:label "Gateway"@en ;
    rdfs:comment "Gateways are used to control how Sequence Flows interact as they converge and diverge within a Process. If the flow does not need to be controlled, then a Gateway is not needed. The term “Gateway” implies that there is a gating mechanism that either allows or disallows passage through the Gateway--that is, as tokens arrive at a Gateway, they can be merged together on input and/or split apart on output as the Gateway mechanisms are invoked."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:FlowNode .

bbo:Task a owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:comment "An atomic activity that is included within a Process. A Task is used when the work in the Process is not broken down to a finer level of Process Model detail. Generally, an end-user, an application, or both will perform the Task. A Task object shares the same shape as the Sub-Process, which is a rectangle that has rounded corners."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:Activity .

bbo:FlowNode a owl:Class ;
    rdfs:label "FlowNode"@en ;
    rdfs:comment "The FlowNode element is used to provide a single element as the source and target Sequence Flow associations (see Figure 8.35) instead of the individual associations of the elements that can connect to Sequence Flows (see the section above). Only the Gateway, Activity, Choreography Activity, and Event elements can connect to Sequence Flows and thus, these elements are the only ones that are sub-classes of FlowNode."@en ;
    rdfs:isDefinedBy <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    rdfs:subClassOf bbo:FlowElement .

<https://www.irit.fr/recherches/MELODI/ontologies/BBO> a owl:Ontology ;
    rdfs:label "BBO (BPMN 2.0 Based Ontology), subset" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://www.irit.fr/recherches/MELODI/ontologies/BBO> ;
    owl:versionInfo "1.0.0" .

