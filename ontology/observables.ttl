@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# The properties the platform's own modules observe (sosa:ObservableProperty individuals, D-47/D-48).
# An observation is one observed claim: subject = feature of interest, predicate sosa:hasSimpleResult,
# qualifier sosa:observedProperty = one of these, valid time = the window.

<https://w3id.org/knowledge-kernel/observables>
    a owl:Ontology ;
    rdfs:label "Observable properties" ;
    owl:versionInfo "0.4.0" .

<urn:kk:property:case-count> a sosa:ObservableProperty ;
    rdfs:label "case count" ;
    skos:definition "Number of cases (process instances) that started in the window; on a step, the cases in which the step occurred at least once." .
<urn:kk:property:event-count> a sosa:ObservableProperty ;
    rdfs:label "event count" ;
    skos:definition "Number of times a step occurred in cases that started in the window (more than the case count means rework). With the qualifier bbo:has_resource, the occurrences carried out by that resource." .
<urn:kk:property:start-count> a sosa:ObservableProperty ;
    rdfs:label "start count" ;
    skos:definition "Number of cases that began with the step." .
<urn:kk:property:end-count> a sosa:ObservableProperty ;
    rdfs:label "end count" ;
    skos:definition "Number of cases that ended with the step." .
<urn:kk:property:directly-follows-count> a sosa:ObservableProperty ;
    rdfs:label "directly-follows count" ;
    skos:definition "Number of times the step directly followed the step named in the qualifier bbo:has_previousFlowNode, within one case." .
<urn:kk:property:wait-seconds-mean> a sosa:ObservableProperty ;
    rdfs:label "mean wait (seconds)" ;
    skos:definition "Mean time in seconds between the step named in the qualifier bbo:has_previousFlowNode and this step, when it directly followed it." .
<urn:kk:property:wait-seconds-max> a sosa:ObservableProperty ;
    rdfs:label "longest wait (seconds)" ;
    skos:definition "Longest time in seconds between the step named in the qualifier bbo:has_previousFlowNode and this step, when it directly followed it." .
<urn:kk:property:wait-seconds> a sosa:ObservableProperty ;
    rdfs:label "wait (seconds)" ;
    skos:definition "Time in seconds between the step named in the qualifier bbo:has_previousFlowNode and this step in one case. Documented limits use it: <step> bbo:maxValue n with this property and the preceding step as qualifiers." .
<urn:kk:property:replicas-up> a sosa:ObservableProperty ;
    rdfs:label "replicas up" ;
    skos:definition "Number of a service's replicas (Prometheus targets) that answered the last scrape in the window." .
<urn:kk:property:request-rate> a sosa:ObservableProperty ;
    rdfs:label "request rate (per second)" ;
    skos:definition "Requests a service answered per second, averaged over the window, all replicas together." .
<urn:kk:property:latency-seconds-mean> a sosa:ObservableProperty ;
    rdfs:label "mean latency (seconds)" ;
    skos:definition "Mean time in seconds a service took to answer a request in the window, all replicas together." .

# Process KPIs (D-119): observations of a process over a time window, computed from an event log's cases by
# process-kpis. The subject is the process, the window is the claim's valid time.
<urn:kk:property:cases-in-window> a sosa:ObservableProperty ;
    rdfs:label "cases in window" ;
    skos:definition "Number of cases whose first event falls in the window, as counted for the process KPIs." .
<urn:kk:property:cycle-time-median-seconds> a sosa:ObservableProperty ;
    rdfs:label "median cycle time (seconds)" ;
    skos:definition "Median over the window's cases of the time in seconds from a case's first event to its last." .
<urn:kk:property:cycle-time-p90-seconds> a sosa:ObservableProperty ;
    rdfs:label "90th percentile cycle time (seconds)" ;
    skos:definition "Nearest-rank 90th percentile over the window's cases of the time in seconds from a case's first event to its last." .
<urn:kk:property:rework-rate> a sosa:ObservableProperty ;
    rdfs:label "rework rate" ;
    skos:definition "Share of the window's cases in which at least one step occurred more than once (0 to 1)." .
<urn:kk:property:throughput-per-day> a sosa:ObservableProperty ;
    rdfs:label "throughput (cases per day)" ;
    skos:definition "The window's cases divided by the length of the window in days." .
<urn:kk:property:cost-per-case> a sosa:ObservableProperty ;
    rdfs:label "cost per case" ;
    skos:definition "Mean over the window's cases that carry a cost of the sum of their events' costs, in the log's own unit; only where the log has a cost column." .
<urn:kk:property:handoffs-per-case> a sosa:ObservableProperty ;
    rdfs:label "handoffs per case" ;
    skos:definition "Mean over the window's cases of the times consecutive events were carried out by different resources; only where the log names resources." .

# The qualifier that marks a KPI observation against a person's target (a bbo:maxValue or bbo:minValue claim
# on the process with the KPI as sosa:observedProperty): the value is `met` or `missed`, plain arithmetic.
<urn:kk:property:target-status> a rdf:Property ;
    rdfs:label "target status" ;
    skos:definition "Qualifier on a KPI observation: `met` or `missed`, the value compared with the target a person stated for it; the target's bound is carried beside it under bbo:maxValue or bbo:minValue." .
