@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Kinds of discrepancy between a documented and an observed process (D-50). A discrepancy is an
# oa:Annotation (inferred, derived from the claims compared) with dcterms:type one of these, oa:hasTarget
# the steps it concerns and oa:bodyValue a sentence for the reviewer.

<https://w3id.org/knowledge-kernel/conformance>
    a owl:Ontology ;
    rdfs:label "Discrepancy, revision, anomaly and action kinds" ;
    owl:versionInfo "0.3.0" .

<urn:kk:discrepancy-kind> a skos:ConceptScheme ; rdfs:label "discrepancy kinds" .
<urn:kk:discrepancy-kind:skip> a skos:Concept ; skos:inScheme <urn:kk:discrepancy-kind> ; skos:prefLabel "skipped step" ;
    skos:definition "Cases went from one step to a step that is documented to come later, without the step documented between them." .
<urn:kk:discrepancy-kind:swap> a skos:Concept ; skos:inScheme <urn:kk:discrepancy-kind> ; skos:prefLabel "swapped order" ;
    skos:definition "Cases went from B to A where the documented process goes from A to B." .
<urn:kk:discrepancy-kind:rework> a skos:Concept ; skos:inScheme <urn:kk:discrepancy-kind> ; skos:prefLabel "rework" ;
    skos:definition "A step directly repeated itself, which the documented process does not allow." .
<urn:kk:discrepancy-kind:unexpected> a skos:Concept ; skos:inScheme <urn:kk:discrepancy-kind> ; skos:prefLabel "unexpected path" ;
    skos:definition "Cases went from one step to another along a path the documented process does not have." .
<urn:kk:discrepancy-kind:missing> a skos:Concept ; skos:inScheme <urn:kk:discrepancy-kind> ; skos:prefLabel "path never taken" ;
    skos:definition "A documented path between two steps was never observed." .
<urn:kk:discrepancy-kind:limit> a skos:Concept ; skos:inScheme <urn:kk:discrepancy-kind> ; skos:prefLabel "time limit exceeded" ;
    skos:definition "An observed wait between two steps exceeded the documented limit." .
<urn:kk:discrepancy-kind:rare> a skos:Concept ; skos:inScheme <urn:kk:discrepancy-kind> ; skos:prefLabel "rare paths" ;
    skos:definition "Paths outside the documented process, each taken in a smaller share of cases than the reporting threshold, reported together as one discrepancy targeting the process (D-75)." .

# Revisions the process learner proposes (D-76): an oa:Annotation targeting the steps, inferred and
# derived from the confirmed discrepancy, next to the documented path it adds; a person approves it.
<urn:kk:revision-kind> a skos:ConceptScheme ; rdfs:label "revision kinds" .
<urn:kk:revision-kind:add-path> a skos:Concept ; skos:inScheme <urn:kk:revision-kind> ; skos:prefLabel "learned path" ;
    skos:definition "A path added to the documented process because people confirmed that practice takes it in a large share of cases." .

# Anomalies (M2-T6, D-53): an oa:Annotation on a service's node, derived from the observation (and the
# documented limit) it concerns, valid for the observation's window.
<urn:kk:anomaly-kind> a skos:ConceptScheme ; rdfs:label "anomaly kinds" .
<urn:kk:anomaly-kind:limit> a skos:Concept ; skos:inScheme <urn:kk:anomaly-kind> ; skos:prefLabel "over the documented limit" ;
    skos:definition "An observation exceeded the documented limit (bbo:maxValue) for its property." .
<urn:kk:anomaly-kind:zscore> a skos:Concept ; skos:inScheme <urn:kk:anomaly-kind> ; skos:prefLabel "unusual value" ;
    skos:definition "An observation lies more than three standard deviations from the mean of the previous windows." .

# Actions an actuator may carry out (M2-T6, D-53): the fixed list. A plan step is a sosa:Actuation with
# dcterms:type one of these, sosa:hasFeatureOfInterest the service's node and, for scale, the replica
# count as sosa:hasSimpleResult.
<urn:kk:action> a skos:ConceptScheme ; rdfs:label "actions" .
<urn:kk:action:scale> a skos:Concept ; skos:inScheme <urn:kk:action> ; skos:prefLabel "scale" ;
    skos:definition "Run the given number of replicas of a service." .
<urn:kk:action:restart> a skos:Concept ; skos:inScheme <urn:kk:action> ; skos:prefLabel "restart" ;
    skos:definition "Restart every replica of a service." .
