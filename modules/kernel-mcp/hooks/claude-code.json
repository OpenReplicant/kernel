{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "kernel-mcp-hook session-start", "timeout": 10}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "kernel-mcp-hook prompt", "timeout": 10}]}
    ],
    "PreToolUse": [
      {"hooks": [{"type": "command", "command": "kernel-mcp-cue", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "kernel-mcp-hook session-end", "timeout": 10}]}
    ]
  }
}
