{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/scripts/lint.sh\" --quiet"}
        ]
      }
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "echo done"}]}
    ]
  }
}
