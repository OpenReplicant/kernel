{
  "ruleChain": {"id": "coder_solve", "name": "coder: a model writes code, the sandbox tests it (on command)", "root": true},
  "metadata": {
    "nodes": [
      {"id": "prompt", "type": "x/python", "name": "task -> prompt",
       "configuration": {"script": "${module_dir}/steps/prompt.py", "timeout": "30s"}},
      {"id": "model", "type": "x/python", "name": "model call",
       "configuration": {"script": "${kernel_dir}/kernel/nodes/model_call.py", "timeout": "180s"}},
      {"id": "prepare", "type": "x/python", "name": "reply -> sandbox run",
       "configuration": {"script": "${module_dir}/steps/prepare.py", "timeout": "30s"}},
      {"id": "sandbox", "type": "x/python", "name": "sandbox run",
       "configuration": {"script": "${kernel_dir}/kernel/nodes/sandbox_run.py", "timeout": "120s"}},
      {"id": "observe", "type": "x/python", "name": "result -> claim",
       "configuration": {"script": "${module_dir}/steps/observe.py", "timeout": "30s"}},
      {"id": "write", "type": "x/python", "name": "graph write",
       "configuration": {"script": "${kernel_dir}/kernel/nodes/graph_write.py", "timeout": "30s"}}
    ],
    "connections": [
      {"fromId": "prompt", "toId": "model", "type": "Success"},
      {"fromId": "model", "toId": "prepare", "type": "Success"},
      {"fromId": "prepare", "toId": "sandbox", "type": "Success"},
      {"fromId": "sandbox", "toId": "observe", "type": "Success"},
      {"fromId": "observe", "toId": "write", "type": "Success"}
    ]
  }
}
